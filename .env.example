# Local development template: cp .env.example .env, then replace the secret.
# The API refuses to start when APP_AUTH_JWT_SECRET is shorter than 32 characters.
APP_APP_NAME=backend-ifter
APP_APP_ENV=development
APP_HTTP_PORT=8080
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=app
APP_DB_PASSWORD=app
APP_DB_NAME=app
APP_AUTH_JWT_SECRET=change-me-to-at-least-32-characters-long
APP_AUTH_JWT_ISSUER=backend-ifter
APP_AUTH_JWT_AUDIENCE=backend-ifter-api
APP_AUTH_ACCESS_TOKEN_TTL=12h
APP_LOG_FORMAT=text
APP_LOG_LEVEL=debug
