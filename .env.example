# Local development only. Do not commit real credentials.
CONFIG_FILE=configs/config.yaml

# Overrides for configs/config.yaml (optional).
IFTER_APP_ENV=development
IFTER_HTTP_PORT=8082
# IFTER_HTTP_TRUSTED_PROXIES=127.0.0.1/32
IFTER_DB_HOST=localhost
IFTER_DB_PORT=5433
IFTER_DB_USER=ifter
IFTER_DB_PASSWORD=ifter
IFTER_DB_NAME=ifter
IFTER_DB_SSLMODE=disable
IFTER_LOG_LEVEL=debug
IFTER_LOG_FORMAT=text

# Development only. Use a random 32+ character secret in real deployments.
IFTER_AUTH_JWT_SECRET=dev-only-change-me-32-characters-minimum
IFTER_AUTH_COOKIE_SECURE=false
IFTER_AUTH_ALLOWED_ORIGINS=http://localhost:3000
# IFTER_AUTH_INVITE_TOKEN_TTL=72h
# IFTER_AUTH_RESET_TOKEN_TTL=1h

# Optional first administrator. Remove the password after the first startup.
# IFTER_AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
# IFTER_AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# IFTER_AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-this-password
# IFTER_AUTH_BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# File import bersifat privat; direktori tidak boleh disajikan sebagai static file.
IFTER_IMPORTS_DIR=./storage/imports
# IFTER_IMPORTS_MAX_FILE_SIZE=5242880
# IFTER_IMPORTS_MAX_ROWS=2000
# IFTER_IMPORTS_FILE_RETENTION=168h
# IFTER_IMPORTS_ERROR_RETENTION=720h
