# Copy to .env for local development. `make run` and `make token` load it.
# Environment variables override configs/config.yaml.
APP_APP_NAME=backend-skeleton
APP_APP_ENV=development
APP_HTTP_HOST=0.0.0.0
APP_HTTP_PORT=8080
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=app
APP_DB_PASSWORD=app
APP_DB_NAME=app
APP_LOG_LEVEL=debug
APP_LOG_FORMAT=text
APP_AUTH_JWT_SECRET=change-me-to-at-least-32-characters-long
